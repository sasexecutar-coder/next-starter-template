{
	"name": "next-starter-template",
	"description": "A statically generated blog using Next.js, Markdown and TypeScript, deployed on Cloudflare Workers.",
	"cloudflare": {
		"label": "Next.js Framework Starter",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/05eee9e0-2c04-48fd-11bf-84e65f839000/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/4e913a56-fd99-4372-0586-9f1364173100/preview",
		"publish": true
	},
	"dependencies": {
		"@opennextjs/cloudflare": "1.14.0",
		"classnames": "^2.5.1",
		"date-fns": "^3.6.0",
		"gray-matter": "^4.0.3",
		"next": "16.0.7",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"rehype-stringify": "^10.0.1",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"three": "^0.184.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "3",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@types/three": "^0.184.1",
		"autoprefixer": "^10.4.19",
		"eslint": "9.39.2",
		"eslint-config-next": "16.0.7",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.4",
		"typescript": "5.9.3",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"build": "npm run sync:brain && opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
		"check": "npm run build && tsc",
		"deploy": "npm run sync:brain && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"dev": "npm run sync:brain && next dev",
		"lint": "next lint",
		"preview": "npm run sync:brain && opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"start": "next start",
		"sync:brain": "node scripts/sync-brain-assets.mjs",
		"audit:ds": "node scripts/ds-audit.mjs"
	}
}
