{# Um bloco de conteúdo. Tipos: p, list, h3, callout, grid, steps, commands, code, table, checklist, rules, faq, timeline, swatches, form #}
{% set bid = s.id ~ '-' ~ loop.index %}
{% if b.type == 'p' %}<p>{{ b.text }}</p>
{% elif b.type == 'h3' %}<h3>{{ b.text }}</h3>
{% elif b.type == 'list' %}<ul class="list">{% for i in b['items'] %}<li>{{ i }}</li>{% endfor %}</ul>
{% elif b.type == 'callout' %}<aside class="callout"><span class="bracket"></span><span class="bracket"></span><span class="bracket"></span><span class="bracket"></span>{% if b.get('title') %}<p class="eyebrow">{{ b.title }}</p>{% endif %}<p>{{ b.text }}</p></aside>
{% elif b.type == 'grid' %}<div class="eb-grid">{% for c in b['items'] %}<div class="panel">{% if c.get('kicker') %}<p class="meta">{{ c.kicker }}</p>{% endif %}<h3>{{ c.title }}</h3><p>{{ c.text }}</p></div>{% endfor %}</div>
{% elif b.type == 'steps' %}<ol class="eb-steps">{% for st in b['items'] %}<li><span class="n" aria-hidden="true">{{ loop.index }}</span><div><strong>{{ st.title }}</strong><span>{{ st.text }}</span></div></li>{% endfor %}</ol>
{% elif b.type == 'commands' %}{% for c in b['items'] %}<div class="cmd"><div class="cmd-head"><span class="cmd-id">{{ c.id }}</span><code class="cmd-slash" id="{{ bid }}-c{{ loop.index }}">{{ c.slash }}</code>{% if c.get('tag') %}<span class="chip chip-gap">{{ c.tag }}</span>{% endif %}</div><div class="cmd-row"><span class="cmd-say">{{ c.does }}{% if c.get('say') %} · diga: “{{ c.say }}”{% endif %}</span><button class="copy" type="button" data-copy="{{ bid }}-c{{ loop.index }}">Copiar</button></div></div>{% endfor %}
{% elif b.type == 'code' %}<pre class="code" id="{{ bid }}">{{ b.text }}</pre><button class="copy" type="button" data-copy="{{ bid }}">Copiar</button>
{% elif b.type == 'table' %}<div class="eb-table-wrap"><table class="eb-table">{% if b.get('caption') %}<caption class="sr-only">{{ b.caption }}</caption>{% endif %}<thead><tr>{% for h in b.head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for r in b.rows %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
{% elif b.type == 'checklist' %}<ul class="check">{% for i in b['items'] %}<li><label><input type="checkbox" data-key="{{ bid }}-{{ loop.index }}"><span>{{ i }}</span></label></li>{% endfor %}</ul>
{% elif b.type == 'rules' %}<div class="rules"><div class="panel yes"><h3><span class="dot" aria-hidden="true"></span>{{ b.yes_title | default('Pode') }}</h3><ul>{% for i in b.yes %}<li>{{ i }}</li>{% endfor %}</ul></div><div class="panel no"><h3><span class="dot" aria-hidden="true"></span>{{ b.no_title | default('Não deve fingir') }}</h3><ul>{% for i in b.no %}<li>{{ i }}</li>{% endfor %}</ul></div></div>
{% elif b.type == 'faq' %}<div class="faq">{% for q in b['items'] %}<details><summary>{{ q.q }}</summary><p>{{ q.a }}</p></details>{% endfor %}</div>
{% elif b.type == 'timeline' %}<ol class="timeline">{% for t in b['items'] %}<li><span class="when">{{ t.when }}</span><strong>{{ t.title }}</strong><span>{{ t.text }}</span></li>{% endfor %}</ol>
{% elif b.type == 'swatches' %}<div class="swatches">{% for t in b['items'] %}<div class="sw"><i style="background:var(--{{ t.token }})"></i><div><strong>{{ t.name }}</strong><code>--{{ t.token }}</code><code>{{ t.value }}</code></div></div>{% endfor %}</div>
{% elif b.type == 'form' %}<form class="form" data-brand-config>{% for f in b.fields %}<label>{{ f.label }}<input name="{{ f.name }}" type="{{ f.input | default('text') }}" placeholder="{{ f.placeholder | default('') }}"><span class="hint">{{ f.hint }}</span></label>{% endfor %}<button class="btn btn-primary btn-md" type="submit">Gerar brand_config.json</button></form><pre class="code" id="brand-config-out" aria-live="polite">{}</pre>
{% else %}{{ raise_unknown_block(b.type) }}{% endif %}
