<!doctype html>
<html lang="{{ deck.lang | default('pt-BR') }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ deck.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{ fonts_url }}" rel="stylesheet">
<style>
{{ brand_css | safe }}
:root{--slide-w:{{ size.w }}px;--slide-h:{{ size.h }}px}
body{background:var(--surface-subtle);padding:var(--space-8)}
main{display:grid;gap:var(--space-8);justify-content:center}
.slide{position:relative;width:var(--slide-w);height:var(--slide-h);overflow:hidden;background:var(--surface-page);color:var(--text-primary);
  padding:var(--space-24) var(--space-24) var(--space-16);display:flex;flex-direction:column}
.slide.dark{background:var(--brand-dark-indigo);color:var(--text-on-dark)}
.slide.dark h2,.slide.dark .kicker,.slide.dark .count,.slide.dark .foot{color:var(--text-on-dark)}
.slide.dark .rule{background:var(--brand-light-blue)}
.head{display:flex;justify-content:space-between;align-items:center}
.kicker{font:500 28px/1 var(--font-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--action-text)}
.count{font:500 28px/1 var(--font-mono);color:var(--text-secondary)}
.body{flex:1;display:flex;flex-direction:column;justify-content:center;gap:var(--space-12)}
.rule{width:96px;height:8px;background:var(--brand-action-blue);border-radius:var(--radius-xs)}
h2{font:800 104px/1.02 var(--font-display);letter-spacing:-0.04em;margin:0}
.kind-cover h2{font-size:120px}
.text{font:400 44px/1.35 var(--font-body);color:inherit;max-width:24ch}
.slide:not(.dark) .text{color:var(--text-secondary)}
.list{list-style:none;margin:0;padding:0;display:grid;gap:var(--space-8)}
.list li{display:grid;grid-template-columns:72px 1fr;gap:var(--space-6);align-items:start;font:500 44px/1.3 var(--font-body)}
.list .n{display:grid;place-items:center;width:72px;height:72px;border-radius:999px;background:var(--brand-action-blue);color:var(--text-on-dark);font:700 36px/1 var(--font-display)}
.stat{font:800 220px/1 var(--font-display);letter-spacing:-0.05em;color:var(--action-text)}
.source{font:400 28px/1.4 var(--font-mono);color:var(--text-secondary)}
.mark-risk{color:var(--semantic-risk)}
.cta-box{border:4px solid var(--brand-action-blue);border-radius:var(--radius-xl);padding:var(--space-12)}
.foot{display:flex;justify-content:space-between;align-items:center;font:700 32px/1 var(--font-display);color:var(--text-primary)}
.foot .handle{font:400 28px/1 var(--font-mono);color:var(--text-secondary)}
.slide.dark .foot .handle{color:var(--brand-light-blue)}
</style>
</head>
<body>
<main aria-label="{{ deck.title }}">
<h1 class="sr-only">{{ deck.title }}</h1>
{% for s in deck.slides %}
<section class="slide kind-{{ s.kind }}{% if s.get('dark') %} dark{% endif %}" id="slide-{{ '%02d' | format(loop.index) }}" aria-label="Slide {{ loop.index }} de {{ deck.slides | length }}">
  <div class="head"><span class="kicker">{{ s.get('kicker', deck.kicker) }}</span><span class="count">{{ '%02d' | format(loop.index) }}/{{ '%02d' | format(deck.slides | length) }}</span></div>
  <div class="body">
    <span class="rule" aria-hidden="true"></span>
    {% if s.kind == 'stat' %}<p class="stat">{{ s.stat }}</p>{% endif %}
    <h2>{{ s.title }}</h2>
    {% if s.get('text') %}<p class="text">{{ s.text }}</p>{% endif %}
    {% if s.get('items') %}<ol class="list">{% for i in s['items'] %}<li><span class="n" aria-hidden="true">{{ loop.index }}</span><span>{{ i }}</span></li>{% endfor %}</ol>{% endif %}
    {% if s.kind == 'stat' %}<p class="source">Fonte: {{ s.source }}</p>{% endif %}
    {% if s.kind == 'cta' %}<div class="cta-box"><p class="text">{{ s.action }}</p></div>{% endif %}
  </div>
  <div class="foot"><span>Risco Cognitivo</span><span class="handle">{{ deck.handle }}</span></div>
</section>
{% endfor %}
</main>
</body>
</html>
